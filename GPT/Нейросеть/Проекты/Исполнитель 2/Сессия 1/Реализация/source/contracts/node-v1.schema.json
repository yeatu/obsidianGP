{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sfra/node-v1.schema.json",
  "title": "SFRA Structural Node v1",
  "type": "object",
  "required": [
    "node_id",
    "source_path",
    "node_type",
    "heading_path",
    "line_start",
    "line_end",
    "content_hash",
    "raw_text"
  ],
  "properties": {
    "node_id": {"type": "string", "minLength": 1},
    "source_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?/).+$"
    },
    "node_type": {"type": "string", "minLength": 1},
    "parent_node_id": {"type": ["string", "null"]},
    "heading_path": {
      "type": "array",
      "items": {"type": "string"}
    },
    "line_start": {"type": "integer", "minimum": 1},
    "line_end": {"type": "integer", "minimum": 1},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "raw_text": {"type": "string"},
    "document_title": {"type": "string"},
    "document_hash": {"type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$"}
  },
  "allOf": [
    {
      "properties": {
        "line_end": {"minimum": 1}
      }
    }
  ],
  "additionalProperties": true
}

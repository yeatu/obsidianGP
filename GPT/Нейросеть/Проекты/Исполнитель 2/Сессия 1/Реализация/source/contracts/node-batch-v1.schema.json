{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sfra/node-batch-v1.schema.json",
  "title": "SFRA Node Batch Manifest v1",
  "type": "object",
  "required": ["schema", "mode"],
  "properties": {
    "schema": {"const": "sfra-node-batch/v1"},
    "mode": {"enum": ["delta", "replace_documents", "full_snapshot"]},
    "replace_source_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "managed_source_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "deleted_node_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "replace_documents"}}},
      "then": {"required": ["replace_source_paths"]}
    },
    {
      "if": {"properties": {"mode": {"const": "full_snapshot"}}},
      "then": {"required": ["managed_source_paths"]}
    }
  ],
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfra.local/schemas/sfra.issue.request.schema.json",
  "title": "SFRA GitHub Issue request envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "operation", "payload"],
  "properties": {
    "protocol_version": { "const": "sfra.issue.v1" },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Unique UUID v4 generated by the client."
    },
    "operation": {
      "type": "string",
      "enum": ["search_vault", "read_source"]
    },
    "payload": {
      "type": "object",
      "description": "Validated separately against search_vault.request.schema.json or read_source.request.schema.json."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "operation": { "const": "search_vault" } },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["query"],
            "properties": {
              "query": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "operation": { "const": "read_source" } },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["node_id", "expected_hash", "scope"]
          }
        }
      }
    }
  ]
}